<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB"
          version="3.0"
          toolsVersion="24765"
          targetRuntime="iOS.CocoaTouch"
          propertyAccessControl="none"
          useAutolayout="YES"
          useTraitCollections="YES"
          useSafeAreas="YES"
          colorMatched="YES">

    <device id="retina6_12"
            orientation="portrait"
            appearance="light"/>

    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin"
                version="24743"/>

        <capability name="Safe area layout guides"
                    minToolsVersion="9.0"/>

        <capability name="documents saved in the Xcode 8 format"
                    minToolsVersion="8.0"/>
    </dependencies>


    <objects>

        <placeholder placeholderIdentifier="IBFilesOwner"
                     id="-1"
                     userLabel="File's Owner"
                     customClass="WelcomeViewController"
                     customModule="YoungStar1"
                     customModuleProvider="target">

            <connections>
                <outlet property="view"
                        destination="i5M-Pr-FkT"
                        id="sfx-zR-JGt"/>
            </connections>

        </placeholder>


        <placeholder placeholderIdentifier="IBFirstResponder"
                     id="-2"
                     customClass="UIResponder"/>


        <view clearsContextBeforeDrawing="NO"
              contentMode="scaleToFill"
              id="i5M-Pr-FkT">

            <rect key="frame"
                  x="0.0"
                  y="0.0"
                  width="393"
                  height="852"/>

            <autoresizingMask key="autoresizingMask"
                              widthSizable="YES"
                              heightSizable="YES"/>


            <subviews>

                <!-- INICIAR SESIÓN -->
                <button opaque="NO"
                        contentMode="scaleToFill"
                        contentHorizontalAlignment="center"
                        contentVerticalAlignment="center"
                        buttonType="system"
                        lineBreakMode="middleTruncation"
                        translatesAutoresizingMaskIntoConstraints="NO"
                        id="ZE0-CJ-5df">

                    <rect key="frame"
                          x="32"
                          y="665"
                          width="329"
                          height="52"/>

                    <state key="normal"
                           title="Iniciar sesión"/>

                    <buttonConfiguration key="configuration"
                                         style="filled"
                                         title="Iniciar sesión">

                        <color key="baseBackgroundColor"
                               red="0.03921568627"
                               green="0.03921568627"
                               blue="0.03921568627"
                               alpha="1"
                               colorSpace="custom"
                               customColorSpace="sRGB"/>

                        <color key="baseForegroundColor"
                               white="1"
                               alpha="1"
                               colorSpace="custom"
                               customColorSpace="genericGamma22GrayColorSpace"/>

                    </buttonConfiguration>

                </button>


                <!-- CREAR CUENTA -->
                <button opaque="NO"
                        contentMode="scaleToFill"
                        contentHorizontalAlignment="center"
                        contentVerticalAlignment="center"
                        buttonType="system"
                        lineBreakMode="middleTruncation"
                        translatesAutoresizingMaskIntoConstraints="NO"
                        id="ejX-pE-W7g">

                    <rect key="frame"
                          x="32"
                          y="729"
                          width="329"
                          height="52"/>

                    <state key="normal"
                           title="Crear cuenta"/>

                    <buttonConfiguration key="configuration"
                                         style="plain"
                                         title="Crear cuenta">

                        <color key="baseForegroundColor"
                               red="0.03921568627"
                               green="0.03921568627"
                               blue="0.03921568627"
                               alpha="1"
                               colorSpace="custom"
                               customColorSpace="sRGB"/>

                    </buttonConfiguration>

                </button>

            </subviews>


            <viewLayoutGuide key="safeArea"
                             id="fnl-2z-Ty3"/>


            <!-- #FFFFFF -->
            <color key="backgroundColor"
                   white="1"
                   alpha="1"
                   colorSpace="custom"
                   customColorSpace="genericGamma22GrayColorSpace"/>


            <constraints>

                <!-- LOGIN -->
                <constraint firstItem="ZE0-CJ-5df"
                            firstAttribute="leading"
                            secondItem="fnl-2z-Ty3"
                            secondAttribute="leading"
                            constant="32"
                            id="wlm-login-leading"/>

                <constraint firstItem="fnl-2z-Ty3"
                            firstAttribute="trailing"
                            secondItem="ZE0-CJ-5df"
                            secondAttribute="trailing"
                            constant="32"
                            id="wlm-login-trailing"/>

                <constraint firstItem="ZE0-CJ-5df"
                            firstAttribute="height"
                            constant="52"
                            id="wlm-login-height"/>


                <!-- SEPARACIÓN -->
                <constraint firstItem="ejX-pE-W7g"
                            firstAttribute="top"
                            secondItem="ZE0-CJ-5df"
                            secondAttribute="bottom"
                            constant="12"
                            id="wlm-buttons-spacing"/>


                <!-- CREAR CUENTA -->
                <constraint firstItem="ejX-pE-W7g"
                            firstAttribute="leading"
                            secondItem="fnl-2z-Ty3"
                            secondAttribute="leading"
                            constant="32"
                            id="wlm-create-leading"/>

                <constraint firstItem="fnl-2z-Ty3"
                            firstAttribute="trailing"
                            secondItem="ejX-pE-W7g"
                            secondAttribute="trailing"
                            constant="32"
                            id="wlm-create-trailing"/>

                <constraint firstItem="ejX-pE-W7g"
                            firstAttribute="height"
                            constant="52"
                            id="wlm-create-height"/>


                <!-- GRUPO DE BOTONES ABAJO -->
                <constraint firstItem="fnl-2z-Ty3"
                            firstAttribute="bottom"
                            secondItem="ejX-pE-W7g"
                            secondAttribute="bottom"
                            constant="32"
                            id="wlm-bottom"/>

            </constraints>


            <point key="canvasLocation"
                   x="108"
                   y="137"/>

        </view>

    </objects>

</document>
